# Flaches node_modules wie bei npm statt pnpm-Symlinks.
# Hostinger kopiert node_modules beim Veroeffentlichen in den Release-Ordner
# und loest dabei die Symlinks auf. Mit dem Standard-Layout von pnpm findet
# next zur Laufzeit dann seine eigenen Abhaengigkeiten nicht mehr
# ("Cannot find module '@swc/helpers/...'") und jede Seite antwortet mit 500.
node-linker=hoisted
